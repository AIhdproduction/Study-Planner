{
  "$defs": {
    "PlanItem": {
      "additionalProperties": false,
      "properties": {
        "module_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module Code"
        },
        "target_semester": {
          "title": "Target Semester",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "passed",
            "running",
            "planned",
            "failed",
            "retake"
          ],
          "title": "Status",
          "type": "string"
        },
        "origin": {
          "default": "generated",
          "enum": [
            "credits",
            "generated",
            "manual"
          ],
          "title": "Origin",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "attempt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "mapping_verification_status": {
          "anyOf": [
            {
              "enum": [
                "unverified",
                "verified",
                "edited"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping Verification Status"
        }
      },
      "required": [
        "target_semester",
        "status"
      ],
      "title": "PlanItem",
      "type": "object"
    },
    "PlanPlaceholder": {
      "additionalProperties": false,
      "properties": {
        "category_id": {
          "title": "Category Id",
          "type": "string"
        },
        "ects_needed": {
          "exclusiveMinimum": 0,
          "title": "Ects Needed",
          "type": "integer"
        },
        "suggested_module_codes": {
          "items": {
            "type": "string"
          },
          "title": "Suggested Module Codes",
          "type": "array"
        },
        "target_semester": {
          "title": "Target Semester",
          "type": "string"
        },
        "origin": {
          "default": "generated",
          "enum": [
            "generated",
            "manual"
          ],
          "title": "Origin",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "category_id",
        "ects_needed",
        "target_semester"
      ],
      "title": "PlanPlaceholder",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "title": "Document",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "retrieved_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved On"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "document"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "planned_modules": {
      "items": {
        "$ref": "#/$defs/PlanItem"
      },
      "title": "Planned Modules",
      "type": "array"
    },
    "placeholders": {
      "items": {
        "$ref": "#/$defs/PlanPlaceholder"
      },
      "title": "Placeholders",
      "type": "array"
    }
  },
  "title": "PlanFile",
  "type": "object"
}